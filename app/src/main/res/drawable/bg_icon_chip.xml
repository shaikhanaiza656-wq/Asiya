<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="9dp"/>
            <gradient
                android:type="radial"
                android:gradientRadius="40dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#8033B7FF"
                android:centerColor="#4022598A"
                android:endColor="#0007121F"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="9dp"/>
            <stroke android:width="1.2dp" android:color="#B37FD6FF"/>
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>
</layer-list>
