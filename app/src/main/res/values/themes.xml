<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SystemHUD" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Background is now fully painted by HudBackgroundView (bundled night-scene,
             identical on every device) so the app no longer needs the live wallpaper. -->
        <item name="android:windowBackground">@color/hud_bg</item>
        <item name="android:statusBarColor">@color/hud_bg</item>
        <item name="android:navigationBarColor">@color/hud_bg</item>
        <item name="android:windowFullscreen">false</item>
        <item name="colorPrimary">@color/hud_accent</item>
        <item name="colorAccent">@color/hud_accent</item>
    </style>
</resources>
