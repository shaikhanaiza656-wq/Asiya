<?xml version="1.0" encoding="utf-8"?>
<!--
    Two separate zones, matching the reference:
    1) "windowPanel" — the glass system-window frame, smaller/inset (not
       edge-to-edge) holding the window controls + a draggable clock group
       and a draggable weather group — user can long-press-drag either to
       reposition it inside the frame; position is saved (Prefs) and
       restored on next launch.
    2) The bottom nav dashboard — OUTSIDE the frame's neon border, in its
       own row below it with a visible gap.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp">

        <!-- ===== Zone 1: the glass system-window frame ===== -->
        <FrameLayout
            android:id="@+id/windowPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.82">

            <com.hud.systemwindow.HudBackgroundView
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.hud.systemwindow.HudFrameView
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Window controls: draggable as a group -->
            <LinearLayout
                android:id="@+id/windowControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="26dp"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnMinimize"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_minimize"
                    android:contentDescription="Minimize" />

                <ImageButton
                    android:id="@+id/btnMaximize"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_maximize"
                    android:contentDescription="Maximize" />

                <ImageButton
                    android:id="@+id/btnClose"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_close"
                    android:contentDescription="Close" />
            </LinearLayout>

            <!-- Clock + date: draggable as a group, defaults to center -->
            <LinearLayout
                android:id="@+id/clockGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/hud_text"
                    android:textSize="56sp"
                    android:fontFamily="sans-serif-thin"
                    android:letterSpacing="0.05"
                    android:shadowColor="#7FD6FF"
                    android:shadowRadius="18"
                    android:shadowDx="0"
                    android:shadowDy="0" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="—"
                    android:textColor="@color/hud_text_dim"
                    android:textSize="14sp"
                    android:letterSpacing="0.15" />
            </LinearLayout>

            <!-- Weather card: draggable as its own group, defaults below clock -->
            <LinearLayout
                android:id="@+id/weatherCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="150dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_panel">

                <TextView
                    android:id="@+id/tvWeather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weather: add API key in Settings"
                    android:textColor="@color/hud_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

        </FrameLayout>

        <!-- Gap between the frame's bottom edge and the dashboard below it -->
        <View
            android:layout_width="match_parent"
            android:layout_height="26dp" />

        <!-- ===== Zone 2: bottom nav dashboard — outside the frame ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="5">

            <LinearLayout android:id="@+id/navHome" style="@style/NavItem">
                <FrameLayout style="@style/NavIconChip">
                    <ImageView style="@style/NavIcon" android:src="@drawable/ic_home" />
                </FrameLayout>
                <TextView style="@style/NavLabel" android:text="HOME" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navTasks" style="@style/NavItem">
                <FrameLayout style="@style/NavIconChip">
                    <ImageView style="@style/NavIcon" android:src="@drawable/ic_tasks" />
                </FrameLayout>
                <TextView style="@style/NavLabel" android:text="TASKS" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navFiles" style="@style/NavItem">
                <FrameLayout style="@style/NavIconChip">
                    <ImageView style="@style/NavIcon" android:src="@drawable/ic_files" />
                </FrameLayout>
                <TextView style="@style/NavLabel" android:text="FILES" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navTools" style="@style/NavItem">
                <FrameLayout style="@style/NavIconChip">
                    <ImageView style="@style/NavIcon" android:src="@drawable/ic_tools" />
                </FrameLayout>
                <TextView style="@style/NavLabel" android:text="TOOLS" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navSettings" style="@style/NavItem">
                <FrameLayout style="@style/NavIconChip">
                    <ImageView style="@style/NavIcon" android:src="@drawable/ic_settings" />
                </FrameLayout>
                <TextView style="@style/NavLabel" android:text="SETTINGS" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
