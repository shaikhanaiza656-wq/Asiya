<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_bg">

    <com.hud.systemwindow.HudBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.hud.systemwindow.HudFrameView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="34dp"
        android:paddingEnd="34dp"
        android:paddingTop="28dp"
        android:paddingBottom="26dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_close"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="SETTINGS"
                android:textColor="@color/hud_text"
                android:textSize="16sp"
                android:letterSpacing="0.15" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="OpenWeatherMap API key"
            android:textColor="@color/hud_text_dim"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Paste your free API key here"
            android:textColorHint="@color/hud_text_dim"
            android:textColor="@color/hud_text"
            android:padding="10dp" />

        <Button
            android:id="@+id/btnSaveKey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button"
            android:text="SAVE"
            android:textColor="@color/hud_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Get a free key at openweathermap.org/api and paste it above. The home screen weather widget calls the real API with this key — nothing is faked."
            android:textColor="@color/hud_text_dim"
            android:textSize="11sp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</FrameLayout>
